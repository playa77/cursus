[Unit]
Description=Cursus rootless container runner (service-account user manager)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
UMask=0077
ExecStart=/opt/cursus/current/venv/bin/cursus runner --config /opt/cursus/current/config.toml
Restart=on-failure
RestartSec=5
Delegate=yes
KillMode=mixed
TimeoutStopSec=60
# Rootless Podman needs user namespaces/newuidmap and delegated cgroups.
# Do not add NoNewPrivileges/RestrictNamespaces or expose its API socket.
# Resource policy is generated in the release-specific unit drop-in by setup.py.
[Install]
WantedBy=default.target
