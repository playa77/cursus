[Unit]
Description=Cursus isolated execution runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/opt/cursus/venv/bin/cursus runner --config /etc/cursus/runner.toml
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cursus-runner /var/lib/cursus-identities
ProtectHome=true

[Install]
WantedBy=multi-user.target
