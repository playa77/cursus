[Unit]
Description=Cursus private control plane
After=network.target postgresql.service

[Service]
Type=simple
User=cursus-control
Group=cursus-control
SupplementaryGroups=cursus-operators
RuntimeDirectory=cursus
RuntimeDirectoryMode=0711
UMask=0077
ExecStart=/opt/cursus/current/venv/bin/cursus control --config /opt/cursus/current/config.toml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cursus-control /run/cursus
KillMode=control-group

[Install]
WantedBy=multi-user.target
