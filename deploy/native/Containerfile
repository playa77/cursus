# Native apps are installed once; login and execution use this exact image ID.
FROM docker.io/library/ubuntu:26.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git python3 python3-venv nodejs npm dbus gnome-keyring \
    libsecret-1-0 build-essential && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/cursus-native/bin /home/session && chown -R 1000:1000 /opt/cursus-native /home/session
COPY install-tools.py /usr/local/lib/cursus-install-tools.py
COPY start-keyring.sh /usr/local/bin/cursus-start-keyring
RUN chmod 755 /usr/local/bin/cursus-start-keyring
USER 1000:1000
ENV HOME=/home/session PATH=/opt/cursus-native/bin:/usr/local/bin:/usr/bin:/bin
RUN python3 /usr/local/lib/cursus-install-tools.py
USER 0:0
RUN ln -s /opt/cursus-native/bin/pi /usr/local/bin/pi && \
    ln -s /opt/cursus-native/bin/claude /usr/local/bin/claude && \
    ln -s /opt/cursus-native/bin/codex /usr/local/bin/codex && \
    ln -s /opt/cursus-native/bin/agy /usr/local/bin/agy
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/sleep"]
CMD ["infinity"]
